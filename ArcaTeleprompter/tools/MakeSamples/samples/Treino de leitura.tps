{"app":"ARCA Teleprompter","v":2,"blocks":[{"kind":"bookmark","runs":[{"text":"Bloco 1 \u00B7 Velocidade"}],"plainText":"Bloco 1 \u00B7 Velocidade","wordCount":4},{"runs":[{"text":"Use as setas para cima e para baixo para ajustar a velocidade. Segure Shift para passos maiores."}],"plainText":"Use as setas para cima e para baixo para ajustar a velocidade. Segure Shift para passos maiores.","wordCount":17},{"runs":[{"text":"As teclas de 1 a 9 escolhem velocidades predefinidas."}],"plainText":"As teclas de 1 a 9 escolhem velocidades predefinidas.","wordCount":9},{"kind":"bookmark","runs":[{"text":"Bloco 2 \u00B7 Marcadores"}],"plainText":"Bloco 2 \u00B7 Marcadores","wordCount":4},{"runs":[{"text":"Page Up e Page Down saltam entre os marcadores, como num clicker de apresenta\u00E7\u00E3o."}],"plainText":"Page Up e Page Down saltam entre os marcadores, como num clicker de apresenta\u00E7\u00E3o.","wordCount":14},{"kind":"stop","runs":[{"text":"Pausa para respirar"}],"plainText":"Pausa para respirar","wordCount":3},{"runs":[{"text":"Ao chegar numa pausa, a rolagem para. Aperte espa\u00E7o para continuar."}],"plainText":"Ao chegar numa pausa, a rolagem para. Aperte espa\u00E7o para continuar.","wordCount":11},{"kind":"bookmark","runs":[{"text":"Bloco 3 \u00B7 Voz"}],"plainText":"Bloco 3 \u00B7 Voz","wordCount":4},{"runs":[{"text":"Ligue o acompanhamento por voz na aba Voz e leia este texto em voz alta. A rolagem segue a sua leitura e para quando voc\u00EA improvisa."}],"plainText":"Ligue o acompanhamento por voz na aba Voz e leia este texto em voz alta. A rolagem segue a sua leitura e para quando voc\u00EA improvisa.","wordCount":26}],"html":"\u003Cp data-bm=\u00221\u0022 contenteditable=\u0022false\u0022\u003EBloco 1 \u00B7 Velocidade\u003C/p\u003E\u003Cp\u003EUse as setas para cima e para baixo para ajustar a velocidade. Segure Shift para passos maiores.\u003C/p\u003E\u003Cp\u003EAs teclas de 1 a 9 escolhem velocidades predefinidas.\u003C/p\u003E\u003Cp data-bm=\u00221\u