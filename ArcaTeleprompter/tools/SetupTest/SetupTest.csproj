    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ArcaSetup\ArcaSetup.csproj" />
    <None Include="..\..\src\ArcaSetup\payload\payload.zip" Link="payload.zip" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
