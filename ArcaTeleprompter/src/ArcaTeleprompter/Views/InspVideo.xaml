<UserControl Grid.IsSharedSizeScope="True" Typography.NumeralStyle="Lining" x:Class="Arca.App.Views.InspVideo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Arca.App.Controls">
  <UserControl.Resources><c:BoolVis x:Key="Vis"/></UserControl.Resources>
  <StackPanel>
    <TextBlock Text="GRAVAÇÃO" Style="{StaticResource Eyebrow}" Margin="16,8,16,10"/>
    <StackPanel Margin="16,0">
      <Border CornerRadius="8" Background="#0E0E0E" MinHeight="150" ClipToBounds="True">
        <Grid>
          <Image x:Name="Preview" Stretch="Uniform" VerticalAlignment="Center"><Image.LayoutTransform><ScaleTransform ScaleX="-1"/></Image.LayoutTransform></Image>
          <TextBlock Text="{Binding CamMessage}" Foreground="#777777" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding CamOn, Converter={StaticResource Vis}, ConverterParameter=not}" TextWrapping="Wrap" TextAlignment="Center" Margin="12"/>
          <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="8,3" CornerRadius="5" Background="#99000000" Visibility="{Binding Recording, Converter={StaticResource Vis}}">
            <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{DynamicResource Live}" Margin="0,0,6,0"/><TextBlock Text="{Binding RecLabel}" Foreground="White" FontFamily="{StaticResource FNum}" FontSize="11"/></StackPanel>
          </Border>
        </Grid>
      </Border>
      <ComboBox x:Name="CamBox" Margin="0,10,0,0" ToolTip="Câmera"/>
      <UniformGrid Rows="1" Margin="0,10,0,0">
        <Button x:Name="CamBtn" Style="{StaticResource Pill}" Content="Ligar câmera" Click="Cam_Click" Margin="0,0,3,0" Focusable="False"/>
        <Button x:Name="RecBtn" Style="{StaticResource Primary}" Content="Gravar" Click="Rec_Click" Margin="3,0,0,0" Focusable="False"/>
      </UniformGrid>
      <CheckBox Content="Gravar junto com o prompt" IsChecked="{Binding App.RecordWithPrompt}" Margin="0,10,0,0" ToolTip="Começa a gravar no Play e para na pausa"/>
      <Button x:Name="OpenRec" Style="{StaticResource Pill}" Margin="0,10,0,0" Click="OpenRec_Click" Visibility="Collapsed" Focusable="False"/>
      <TextBlock Text="As gravações (MP4) ficam em Vídeos › ARCA Teleprompter." FontSize="11" Foreground="{DynamicResource Faint}" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </StackPanel>
  </StackPanel>
</UserControl>
