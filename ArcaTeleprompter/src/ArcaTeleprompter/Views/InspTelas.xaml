<UserControl Grid.IsSharedSizeScope="True" Typography.NumeralStyle="Lining" x:Class="Arca.App.Views.InspTelas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Arca.App.Controls"
             xmlns:vm="clr-namespace:Arca.App.ViewModels">
  <UserControl.Resources><c:ResBrush x:Key="Res"/><c:Not x:Key="Not"/><c:BoolVis x:Key="Vis"/></UserControl.Resources>
  <StackPanel>
    <TextBlock Text="{Binding PreviewLabel}" Style="{StaticResource Eyebrow}" Margin="16,8,16,10"/>
    <Border Margin="16,0,16,16" CornerRadius="11" BorderThickness="1" BorderBrush="{DynamicResource Line}" ClipToBounds="True" ToolTip="Duplo clique: abrir a janela do talento" MouseLeftButtonDown="Preview_MouseDown">
      <Grid x:Name="PreviewHost" Height="150"/>
    </Border>
    <Border Style="{StaticResource Divider}"/>

    <!-- Informações na tela (escolha do operador, como no PowerPrompter) -->
    <DockPanel Margin="16,14,16,8">
      <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding TalentHud}" ToolTip="Mostrar informações na janela do talento e nas telas do prompter" AutomationProperties.Name="Informações na tela"/>
      <TextBlock Text="INFORMAÇÕES NA TELA" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
    </DockPanel>
    <StackPanel Margin="16,0,16,14" IsEnabled="{Binding TalentHud}">
      <WrapPanel>
        <CheckBox Content="Bloco atual" IsChecked="{Binding App.HudBlock}" Checked="Hud_Changed" Unchecked="Hud_Changed" Margin="0,0,14,8"/>
        <CheckBox Content="Tempo do bloco" IsChecked="{Binding App.HudTime}" Checked="Hud_Changed" Unchecked="Hud_Changed" Margin="0,0,14,8"/>
        <CheckBox Content="Relógio" IsChecked="{Binding App.HudClock}" Checked="Hud_Changed" Unchecked="Hud_Changed" Margin="0,0,0,8"/>
      </WrapPanel>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Lbl"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="Posição" Style="{StaticResource Label}"/>
        <Border Grid.Column="1" Style="{StaticResource SegBox}" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="HudBottomBtn" Style="{StaticResource Seg}" GroupName="hudpos" Content="Embaixo" Padding="12,0" Checked="HudPos_Checked"/>
            <RadioButton x:Name="HudTopBtn" Style="{StaticResource Seg}" GroupName="hudpos" Content="Em cima" Padding="12,0" Checked="HudPos_Checked"/>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
    <Border Style="{StaticResource Divider}"/>

    <TextBlock Text="TELAS CONECTADAS" Style="{StaticResource Eyebrow}" Margin="16,14,16,6"/>
    <ItemsControl ItemsSource="{Binding Displays}" Margin="8,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="vm:DisplayVM">
          <Border x:Name="row" CornerRadius="8" Padding="8,10">
            <StackPanel>
              <DockPanel>
                <CheckBox IsChecked="{Binding On}" ToolTip="Abrir prompter nesta tela" VerticalAlignment="Top" Margin="0,3,10,0"/>
                <StackPanel>
                  <TextBox Text="{Binding Nick, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}" FontWeight="SemiBold" Padding="2,1" Margin="-3,0,0,0" ToolTip="Clique para renomear"/>
                  <TextBlock Text="{Binding Desc}" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DockPanel>
              <StackPanel Orientation="Horizontal" Margin="25,8,0,0">
                <ToggleButton Style="{StaticResource ToolToggle}" Width="30" Height="26" IsChecked="{Binding FlipH}" ToolTip="Espelhar horizontal (vidro do prompter)" Focusable="False" Margin="0,0,4,0"><c:Icon Data="{x:Static c:Icons.FlipH}" Size="14"/></ToggleButton>
                <ToggleButton Style="{StaticResource ToolToggle}" Width="30" Height="26" IsChecked="{Binding FlipV}" ToolTip="Espelhar vertical" Focusable="False" Margin="0,0,4,0"><c:Icon Data="{x:Static c:Icons.FlipV}" Size="14"/></ToggleButton>
                <Button Style="{StaticResource IconBtn}" Width="30" Height="26" Click="Align_Click" Tag="{Binding}" ToolTip="Alinhamento nesta tela (esquerda/centro)" Focusable="False" Margin="0,0,4,0"><c:Icon x:Name="alignIcon" Data="{x:Static c:Icons.AlignL}" Size="14"/></Button>
                <ToggleButton Style="{StaticResource ToolToggle}" Width="30" Height="26" IsChecked="{Binding Find}" ToolTip="Localizar: pisca uma borda na tela" Focusable="False"><c:Icon Data="{x:Static c:Icons.Target}" Size="14"/></ToggleButton>
              </StackPanel>
            </StackPanel>
          </Border>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Align}" Value="center"><Setter TargetName="alignIcon" Property="Data" Value="{x:Static c:Icons.AlignC}"/></DataTrigger>
            <DataTrigger Binding="{Binding Find}" Value="True"><Setter TargetName="row" Property="Background" Value="#26E5484D"/></DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Button Style="{StaticResource Pill}" Height="28" Margin="16,8,16,0" HorizontalAlignment="Stretch" Content="Nova janela de prompter" Click="NewWindow_Click" Focusable="False"/>
    <Border Style="{StaticResource Divider}" Margin="16,16,16,0"/>

    <!-- NDI -->
    <DockPanel Margin="16,14,16,10">
      <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding NdiOn}" ToolTip="Ligar a saída NDI" AutomationProperties.Name="Saída NDI"/>
      <TextBlock Text="SAÍDA NDI" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
    </DockPanel>
    <StackPanel Margin="16,0">
      <DockPanel Margin="0,0,0,10">
        <Ellipse Width="7" Height="7" Fill="{Binding NdiDot, Converter={StaticResource Res}}" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding NdiStatus}" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
      </DockPanel>
      <Grid IsEnabled="{Binding NdiOn, Converter={StaticResource Not}}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Lbl"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="40"/></Grid.RowDefinitions>
        <TextBlock Text="Nome da fonte" Style="{StaticResource Label}"/>
        <TextBox Grid.Column="1" Style="{StaticResource Input}" Text="{Binding App.NdiName, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Grid.Row="1" Text="Formato" Style="{StaticResource Label}"/>
        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="NdiFormat" SelectedValuePath="Id" DisplayMemberPath="Label" SelectedValue="{Binding App.NdiFormat}"/>
      </Grid>
      <CheckBox Content="Espelhar a saída NDI" IsChecked="{Binding App.NdiMirror}" Margin="0,8,0,4" Checked="NdiOption_Click" Unchecked="NdiOption_Click"/>
      <CheckBox Content="Fundo transparente (alpha) para sobrepor no vMix" IsChecked="{Binding App.NdiAlpha}" Margin="0,0,0,4" Checked="NdiOption_Click" Unchecked="NdiOption_Click"/>
    </StackPanel>
    <Border Style="{StaticResource Divider}" Margin="16,12,16,0"/>

    <!-- Monitor web / iPad -->
    <DockPanel Margin="16,14,16,10">
      <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding WebOn}" ToolTip="Ligar o monitor web" AutomationProperties.Name="Monitor web"/>
      <TextBlock Text="MONITOR WEB · IPAD" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
    </DockPanel>
    <StackPanel Margin="16,0">
      <DockPanel Margin="0,0,0,10">
        <Ellipse Width="7" Height="7" Fill="{Binding WebDot, Converter={StaticResource Res}}" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding WebStatus}" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
      </DockPanel>
      <DockPanel Margin="0,0,0,10">
        <Button DockPanel.Dock="Right" Style="{StaticResource Pill}" Content="Copiar" Click="CopyUrl_Click" Margin="6,0,0,0" Focusable="False" x:Name="CopyBtn"/>
        <TextBox Style="{StaticResource Input}" IsReadOnly="True" Text="{Binding WebUrl, Mode=OneWay}" FontFamily="{StaticResource FNum}" FontSize="12" Foreground="{DynamicResource Muted}"/>
      </DockPanel>
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Lbl"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="Senha" Style="{StaticResource Label}"/>
        <TextBox Grid.Column="1" Style="{StaticResource Input}" Text="{Binding App.WebPassword, UpdateSourceTrigger=PropertyChanged, Delay=500}" ToolTip="Opcional: pedida no navegador/iPad"/>
      </Grid>
      <CheckBox Content="Permitir controlar o prompter pelo navegador" IsChecked="{Binding App.WebControl}" Checked="WebOption_Click" Unchecked="WebOption_Click" Margin="0,0,0,4"/>
      <CheckBox Content="Ligar o monitor web ao abrir o app" IsChecked="{Binding App.WebOnStart}" Margin="0,0,0,10"/>
      <Button Style="{StaticResource Pill}" Content="Abrir monitor web e QR code do iPad" Click="OpenMonitor_Click" Focusable="False"/>
    </StackPanel>
  </StackPanel>
</UserControl>
