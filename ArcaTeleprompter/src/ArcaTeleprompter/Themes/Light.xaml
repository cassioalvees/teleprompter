<!-- Tema claro (README §7). As chaves são as mesmas do tema escuro; o app troca o dicionário em tempo de execução. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Bg" Color="#F2F2F0"/>
  <SolidColorBrush x:Key="Ui" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Soft" Color="#F7F7F5"/>
  <SolidColorBrush x:Key="Sunk" Color="#EEEEEC"/>
  <SolidColorBrush x:Key="Line" Color="#E2E2DE"/>
  <SolidColorBrush x:Key="Hair" Color="#EBEBEB"/>
  <SolidColorBrush x:Key="Text" Color="#1A1A18"/>
  <SolidColorBrush x:Key="Muted" Color="#5A5A55"/>
  <SolidColorBrush x:Key="Faint" Color="#67675F"/>
  <SolidColorBrush x:Key="Accent" Color="#D42B1E"/>
  <SolidColorBrush x:Key="AccentInk" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="AccentSoft" Color="#14D42B1E"/>
  <SolidColorBrush x:Key="AccentLine" Color="#40D42B1E"/>
  <SolidColorBrush x:Key="Ok" Color="#2F8F5B"/>
  <SolidColorBrush x:Key="OkSoft" Color="#E9F5EE"/>
  <SolidColorBrush x:Key="Live" Color="#E5484D"/>
  <SolidColorBrush x:Key="Hover" Color="#F7F7F5"/>
  <SolidColorBrush x:Key="Field" Color="#F7F7F5"/>
  <Color x:Key="ShadowColor">#1A1A18</Color>
  <DropShadowEffect x:Key="Sh1" BlurRadius="2" ShadowDepth="1" Direction="270" Opacity="0.05" Color="#1A1A18"/>
  <DropShadowEffect x:Key="Sh2" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.08" Color="#1A1A18"/>
  <DropShadowEffect x:Key="Sh3" BlurRadius="50" ShadowDepth="18" Direction="270" Opacity="0.16" Color="#1A1A18"/>
</ResourceDictionary>
