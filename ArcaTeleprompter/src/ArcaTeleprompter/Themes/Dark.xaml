<!-- Tema escuro (README §7). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Bg" Color="#0E0E10"/>
  <SolidColorBrush x:Key="Ui" Color="#1B1B1E"/>
  <SolidColorBrush x:Key="Soft" Color="#26262A"/>
  <SolidColorBrush x:Key="Sunk" Color="#141416"/>
  <SolidColorBrush x:Key="Line" Color="#34343A"/>
  <SolidColorBrush x:Key="Hair" Color="#2B2B30"/>
  <SolidColorBrush x:Key="Text" Color="#ECECEF"/>
  <SolidColorBrush x:Key="Muted" Color="#A0A0A8"/>
  <SolidColorBrush x:Key="Faint" Color="#91919A"/>
  <SolidColorBrush x:Key="Accent" Color="#FF5A4A"/>
  <SolidColorBrush x:Key="AccentInk" Color="#1A0705"/>
  <SolidColorBrush x:Key="AccentSoft" Color="#1FFF5A4A"/>
  <SolidColorBrush x:Key="AccentLine" Color="#4DFF5A4A"/>
  <SolidColorBrush x:Key="Ok" Color="#3EC27F"/>
  <SolidColorBrush x:Key="OkSoft" Color="#0F3D2E"/>
  <SolidColorBrush x:Key="Live" Color="#E5484D"/>
  <SolidColorBrush x:Key="Hover" Color="#26262A"/>
  <SolidColorBrush x:Key="Field" Color="#26262A"/>
  <Color x:Key="ShadowColor">#000000</Color>
  <DropShadowEffect x:Key="Sh1" BlurRadius="2" ShadowDepth="1" Direction="270" Opacity="0.4" Color="#000000"/>
  <DropShadowEffect x:Key="Sh2" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.45" Color="#000000"/>
  <DropShadowEffect x:Key="Sh3" BlurRadius="50" ShadowDepth="18" Direction="270" Opacity="0.6" Color="#000000"/>
</ResourceDictionary>
